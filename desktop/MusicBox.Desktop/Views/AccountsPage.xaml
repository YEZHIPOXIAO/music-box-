<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="MusicBox.Desktop.Views.AccountsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="28,20">
        <StackPanel Spacing="18" MaxWidth="820" HorizontalAlignment="Left">

            <StackPanel Spacing="4">
                <TextBlock Text="账号" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Text="按各平台官方网页提供的选项扫码登录；QQ、微信或其他方式由官方页面展示。密码不会经过本程序。"
                           FontSize="13" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True" />

            <Border CornerRadius="10" Padding="18"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="5">
                        <TextBlock Text="QQ音乐" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="在官方登录页选择扫码方式，手机确认后完成绑定。" TextWrapping="Wrap" FontSize="12" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="打开登录页" Tag="qq" Click="OnWebLoginClick" />
                    <Button Grid.Column="2" Content="解绑" Tag="qq" Click="OnProviderUnbindClick" />
                    <TextBlock x:Name="QQStateText" Grid.Column="3" Text="未绑定" VerticalAlignment="Center" FontSize="12" />
                </Grid>
            </Border>

            <!-- 酷狗 / 酷我：官方网页登录 -->
            <Border CornerRadius="10" Padding="18"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="酷狗音乐 / 酷我音乐" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="点「打开登录页」，使用酷狗或酷我官方网页的二维码扫码登录。手机确认后，点击窗口内的「完成并绑定」。仅保存登录凭证，不保存密码。"
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <Grid ColumnSpacing="10" RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="酷狗音乐"
                                   VerticalAlignment="Center" FontWeight="SemiBold" />
                        <Button Grid.Row="0" Grid.Column="1" Content="打开登录页"
                                Tag="kugou" Click="OnWebLoginClick" />
                        <Button Grid.Row="0" Grid.Column="2" Content="解绑"
                                Tag="kugou" Click="OnProviderUnbindClick" />
                        <TextBlock x:Name="KugouState" Grid.Row="0" Grid.Column="3"
                                   VerticalAlignment="Center" FontSize="12" MinWidth="72"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="未绑定" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="酷我音乐"
                                   VerticalAlignment="Center" FontWeight="SemiBold" />
                        <Button Grid.Row="1" Grid.Column="1" Content="打开登录页"
                                Tag="kuwo" Click="OnWebLoginClick" />
                        <Button Grid.Row="1" Grid.Column="2" Content="解绑"
                                Tag="kuwo" Click="OnProviderUnbindClick" />
                        <TextBlock x:Name="KuwoState" Grid.Row="1" Grid.Column="3"
                                   VerticalAlignment="Center" FontSize="12" MinWidth="72"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="未绑定" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="检测酷狗登录 / 会员" Tag="kugou" Click="OnVerifyMembershipClick" />
                        <Button Content="检测酷我登录 / 会员" Tag="kuwo" Click="OnVerifyMembershipClick" />
                    </StackPanel>
                    <TextBlock x:Name="MembershipResult" Text="凭证已绑定不等于平台已验证会员。点击检测后显示平台结果。" TextWrapping="Wrap" FontSize="12" />
                </StackPanel>
            </Border>

            <Expander Header="备用 API（各平台独立切换）" HorizontalAlignment="Stretch">
                <StackPanel Spacing="10">
                    <TextBlock Text="默认使用官方网页登录。备用 API 必须先在本机运行；不会自动把官方网页凭据发给备用服务。仅切换所选平台的播放接入。" TextWrapping="Wrap" FontSize="12" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="QQMusicApi 配置" Tag="qq" Click="OnBackupConfigClick" />
                        <Button Content="KuGouMusicApi 配置" Tag="kugou" Click="OnBackupConfigClick" />
                        <Button Content="kuwoMusicApi 配置" Tag="kuwo" Click="OnBackupConfigClick" />
                    </StackPanel>
                </StackPanel>
            </Expander>

            <!-- 手动粘贴（兜底） -->
            <Expander Header="手动粘贴 Cookie（高级）" HorizontalAlignment="Stretch">
                <StackPanel Spacing="10" Padding="0,10,0,0">
                    <TextBlock Text="如果网页登录读不到登录态，可以从浏览器复制 Cookie 粘贴到这里。"
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Grid ColumnSpacing="10" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="CookieQQ" Grid.Row="0" Grid.Column="0"
                                 PlaceholderText="QQ音乐 Cookie" />
                        <Button Grid.Row="0" Grid.Column="1" Content="保存"
                                Tag="qq" Click="OnManualSaveClick" />
                        <PasswordBox x:Name="CookieKugou" Grid.Row="1" Grid.Column="0"
                                 PlaceholderText="酷狗 Cookie" />
                        <Button Grid.Row="1" Grid.Column="1" Content="保存"
                                Tag="kugou" Click="OnManualSaveClick" />
                        <PasswordBox x:Name="CookieKuwo" Grid.Row="2" Grid.Column="0"
                                 PlaceholderText="酷我 Cookie" />
                        <Button Grid.Row="2" Grid.Column="1" Content="保存"
                                Tag="kuwo" Click="OnManualSaveClick" />
                    </Grid>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Page>
