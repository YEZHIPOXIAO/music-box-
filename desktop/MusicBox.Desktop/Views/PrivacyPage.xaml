<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="MusicBox.Desktop.Views.PrivacyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="28,20">
        <StackPanel Spacing="16" MaxWidth="760" HorizontalAlignment="Left">

            <StackPanel Spacing="4">
                <TextBlock Text="隐私" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Text="所有数据都只保存在这台电脑上，不上传、不统计。"
                           FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True" />

            <Border CornerRadius="10" Padding="18"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="遥测 / 统计" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Grid.Column="1" Text="无。代码里没有任何上报逻辑。" FontSize="13"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="账号存储" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Grid.Column="1" x:Name="EncryptionText" FontSize="13"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="音频直链" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Grid.Column="1" FontSize="13"
                                       Text="不下发给界面。播放走本机代理，带 vkey 的地址不会出现在页面上。"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="数据位置" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Grid.Column="1" x:Name="PathText" FontSize="12"
                                       IsTextSelectionEnabled="True" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </StackPanel>

                    <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />

                    <StackPanel Spacing="8">
                        <TextBlock Text="清空本地数据" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Text="删除已绑定的账号、歌单和播放历史，不可恢复。"
                                   FontSize="12" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button Content="清空全部本地数据" Click="OnWipeClick" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
