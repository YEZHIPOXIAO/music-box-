<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="MusicBox.Desktop.Views.SearchPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:models="using:MusicBox.Desktop.Views">

    <Grid Padding="28,20,28,0" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Search bar -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="QueryBox" Grid.Column="0"
                     PlaceholderText="搜索歌曲、歌手、专辑…"
                     FontSize="15" Padding="14,10"
                     CornerRadius="8"
                     KeyDown="OnQueryKeyDown" />

            <ComboBox x:Name="ProviderBox" Grid.Column="1" MinWidth="132"
                      CornerRadius="8" VerticalAlignment="Stretch" />
            <ComboBox x:Name="QualityBox" Grid.Column="2" MinWidth="150"
                      CornerRadius="8" VerticalAlignment="Stretch" />
        </Grid>

        <!-- Status line -->
        <InfoBar x:Name="StatusBar" Grid.Row="1"
                 IsOpen="False" IsClosable="True"
                 Severity="Informational" />

        <!-- Results -->
        <Border Grid.Row="2" CornerRadius="10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <Grid>
                <ListView x:Name="ResultList"
                          SelectionMode="Single"
                          IsItemClickEnabled="True"
                          ItemClick="OnTrackInvoked">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="8,2" />
                            <Setter Property="MinHeight" Value="56" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:TrackRow">
                            <Grid ColumnSpacing="14" Padding="6,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title}" FontSize="14"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Subtitle}" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <Border Grid.Column="1" CornerRadius="20" Padding="10,3"
                                        VerticalAlignment="Center"
                                        Background="{x:Bind BadgeBrush}">
                                    <TextBlock Text="{x:Bind ProviderName}" FontSize="11"
                                               Foreground="White" />
                                </Border>

                                <TextBlock Grid.Column="2" Text="{x:Bind Duration}"
                                           FontSize="12" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel x:Name="EmptyState" VerticalAlignment="Center"
                            HorizontalAlignment="Center" Spacing="8" Visibility="Collapsed">
                    <FontIcon Glyph="&#xE721;" FontSize="34"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="输入关键词开始搜索" FontSize="13"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <ProgressRing x:Name="Busy" IsActive="False" Width="34" Height="34"
                              VerticalAlignment="Center" HorizontalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Action bar -->
        <Grid Grid.Row="3" Padding="0,0,0,16" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="PlayButton" Grid.Column="0"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="OnPlayClick" IsEnabled="False">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE768;" FontSize="14" />
                    <TextBlock Text="播放" />
                </StackPanel>
            </Button>

            <Button x:Name="AddButton" Grid.Column="1" Click="OnAddClick" IsEnabled="False">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock Text="加入歌单" />
                </StackPanel>
            </Button>

            <TextBlock x:Name="NowPlaying" Grid.Column="3"
                       VerticalAlignment="Center" FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
    </Grid>
</Page>
