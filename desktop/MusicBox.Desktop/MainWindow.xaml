<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MusicBox.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="MusicBox">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Grid x:Name="AppTitleBar" Height="48" Grid.Row="0" ColumnSpacing="10" Padding="16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon Grid.Column="0" Glyph="&#xE8D6;" FontSize="17" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="MusicBox" FontSize="13" FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="TitleBarSubtitle" Grid.Column="2" FontSize="12"
                       VerticalAlignment="Center" HorizontalAlignment="Right"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        </Grid>

        <NavigationView x:Name="Nav" Grid.Row="1"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        PaneDisplayMode="Left"
                        OpenPaneLength="212"
                        SelectionChanged="OnNavSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="搜索" Tag="search">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Find" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="我的歌单" Tag="playlists">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="List" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="账号" Tag="accounts">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Contact" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="隐私" Tag="privacy">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Permissions" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>

        <!-- Player bar -->
        <Border Grid.Row="2" MinHeight="154"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Grid Padding="20,10" ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Now playing -->
                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                    <TextBlock x:Name="NowTitle" Text="未在播放" FontSize="13"
                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="NowArtist" Text="选择一首歌开始" FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="TransportStatus" Text="未在播放" FontSize="11" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- Transport -->
                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8"
                                HorizontalAlignment="Center">
                        <Button Content="⏮" Click="OnPreviousClick" ToolTipService.ToolTip="上一曲" AutomationProperties.Name="上一曲" />
                        <Button x:Name="PlayPauseButton" Click="OnPlayPauseClick"
                                ToolTipService.ToolTip="播放 / 暂停" AutomationProperties.Name="播放或暂停"
                                MinWidth="104" Height="38" CornerRadius="19"
                                Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon x:Name="PlayIcon" Glyph="&#xE768;" FontSize="14" />
                                <TextBlock x:Name="PlayButtonText" Text="播放" />
                            </StackPanel>
                        </Button>
                        <Button Content="⏭" Click="OnNextClick" ToolTipService.ToolTip="下一曲" AutomationProperties.Name="下一曲" />
                        <Button x:Name="StopButton" Content="■ 停止" Click="OnStopClick" Height="38"
                                ToolTipService.ToolTip="停止播放并释放音源" AutomationProperties.Name="停止" />
                        <Button Content="↻ 重播" Click="OnReplayClick" Height="38" ToolTipService.ToolTip="从头播放当前曲目" />

                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <ComboBox x:Name="PlaybackModeBox" Width="112" SelectionChanged="OnPlaybackModeChanged" ToolTipService.ToolTip="播放模式">
                            <ComboBoxItem Content="顺序播放" Tag="0" />
                            <ComboBoxItem Content="列表循环" Tag="1" />
                            <ComboBoxItem Content="单曲循环" Tag="2" />
                            <ComboBoxItem Content="随机播放" Tag="3" />
                        </ComboBox>
                        <ComboBox x:Name="PlayerQualityBox" Width="112" SelectionChanged="OnPlayerQualityChanged" ToolTipService.ToolTip="请求音质，以平台实际授权为准">
                            <ComboBoxItem Content="自动音质" Tag="auto" />
                            <ComboBoxItem Content="标准128" Tag="128" />
                            <ComboBoxItem Content="高品320" Tag="320" />
                            <ComboBoxItem Content="无损FLAC" Tag="flac" />
                        </ComboBox>
                        <Button Content="播放队列" Click="OnQueueClick" />
                        <Button Content="桌面歌词" Click="OnDesktopLyricsClick" />
                    </StackPanel>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PosText" Grid.Column="0" Text="0:00" FontSize="11"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <Slider x:Name="Progress" Grid.Column="1" Minimum="0" Maximum="1"
                                SmallChange="5" LargeChange="30"
                                ValueChanged="OnSeekChanged" />
                        <TextBlock x:Name="DurText" Grid.Column="2" Text="0:00" FontSize="11"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </Grid>
                </StackPanel>

                <!-- Volume -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center" Width="175">
                    <Button x:Name="MuteButton" Click="OnMuteClick" ToolTipService.ToolTip="静音 / 恢复音量" AutomationProperties.Name="静音">
                        <FontIcon Glyph="&#xE767;" FontSize="14" />
                    </Button>
                    <Slider x:Name="Volume" Minimum="0" Maximum="100" Width="110"
                            StepFrequency="5" ValueChanged="OnVolumeChanged" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
